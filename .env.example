SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_no_host_publico
SUPABASE_BUCKET=agent-tc-evidences
SUPABASE_SCHEMA=public
SUPABASE_TABLE_PREFIX=agent_tc_

# Banco principal: supabase, postgres, sqlite ou local-json.
AGENT_TC_BACKEND=supabase

# Evidencias/arquivos: supabase ou local.
AGENT_TC_STORAGE=supabase
# AGENT_TC_STORAGE_ROOT=S:\Teste automatico\Arquivos\AgenteTC\evidencias
# AGENT_TC_PUBLIC_BASE_URL=http://servidor:8000/files

# PostgreSQL local/empresa, usado quando AGENT_TC_BACKEND=postgres.
# POSTGRES_DSN=postgresql://usuario:senha@servidor:5432/agent_tc
POSTGRES_SCHEMA=public
POSTGRES_TABLE_PREFIX=agent_tc_

# Token opcional para proteger endpoints usados pelo JenkinsBridge quando ele fala com a API.
# AGENT_TC_BRIDGE_TOKEN=

AI_PROVIDER=openai
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=6000
OPENAI_API_KEY=cole_a_chave_da_openai_no_host_publico
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=6000
GEMINI_API_KEY=cole_a_chave_do_gemini_no_host_publico
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_OUTPUT_TOKENS=12000

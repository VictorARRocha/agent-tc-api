# Copie este arquivo para docker.env na D01 e preencha os valores reais.
# Nao commitar docker.env, ele contem senha e tokens.

POSTGRES_DB=agent_tc
POSTGRES_USER=agent_tc
POSTGRES_PASSWORD=troque_esta_senha

POSTGRES_SCHEMA=public
POSTGRES_TABLE_PREFIX=agent_tc_

# API no host D01. O dashboard/Caddy ocupa a porta 8000.
AGENT_TC_API_PORT=8001

# Prefixo das URLs registradas para as evidencias. Abrir arquivos exige login.
AGENT_TC_PUBLIC_BASE_URL=http://SEU_SUBDOMINIO.duckdns.org:10443/api/files

# Token interno compartilhado entre API, AgenteTC das VMs e JenkinsBridge.
# Use o mesmo valor em:
# - API\deploy\d01\docker.env
# - ..\..\..\PythonRodagem\.env nas VMs de rodagem
# - ..\..\..\JenkinsBridge\.env na D01
AGENT_TC_BRIDGE_TOKEN=troque_este_token

# Auth local e definido no Compose. Duracao da sessao do dashboard.
AGENT_TC_AUTH_SESSION_HOURS=24

# Agrupamento por IA. Na D01 o provedor atual e Gemini.
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=6000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_OUTPUT_TOKENS=12000

# Quando o modelo esta ocupado (503/429/5xx/sem conexao): tenta de novo AI_RETRIES vezes,
# esperando AI_RETRY_SECONDS; depois passa para a OpenAI (so se OPENAI_API_KEY estiver
# preenchida) e por ultimo para o GEMINI_FALLBACK_MODEL. Deixe GEMINI_FALLBACK_MODEL= vazio
# para desligar a reserva. Valores padrao:
# AI_RETRIES=2
# AI_RETRY_SECONDS=15
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=

# Alternativa, se o provedor mudar para OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_TIMEOUT_SECONDS=120
# OPENAI_MAX_OUTPUT_TOKENS=6000

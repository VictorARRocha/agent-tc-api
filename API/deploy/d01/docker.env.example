# Copie este arquivo para docker.env na D01 e preencha os valores reais.
# Nao commitar docker.env, ele contem senha e tokens.

POSTGRES_DB=agent_tc
POSTGRES_USER=agent_tc
POSTGRES_PASSWORD=troque_esta_senha

POSTGRES_SCHEMA=public
POSTGRES_TABLE_PREFIX=agent_tc_

# Porta publicada na D01.
AGENT_TC_API_PORT=8000

# URL que o dashboard e os registros de evidencias usam para abrir arquivos.
# Trocar pelo IP/DNS real da D01 ou pelo reverse proxy HTTPS quando existir.
AGENT_TC_PUBLIC_BASE_URL=http://IP_DA_D01:8000/files

# Token interno compartilhado entre API, AgenteTC das VMs e JenkinsBridge.
# Use o mesmo valor em:
# - API\deploy\d01\docker.env
# - ..\..\..\PythonRodagem\.env nas VMs de rodagem
# - ..\..\..\JenkinsBridge\.env na D01
AGENT_TC_BRIDGE_TOKEN=troque_este_token

# Auth local da API. O primeiro cadastro vira admin aprovado para bootstrap.
AGENT_TC_AUTH_BACKEND=local
AGENT_TC_AUTH_SESSION_HOURS=24

# Necessario para agrupamento por IA. Preencha somente o provedor escolhido.
AI_PROVIDER=openai
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=6000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=6000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_OUTPUT_TOKENS=12000

# Copie para RegravacaoBridge\.env na D01 e NAO adicione o .env ao SVN.

# API Agent TC (a mesma usada pelo JenkinsBridge) e o mesmo AGENT_TC_BRIDGE_TOKEN
# de API\deploy\d01\docker.env.
AGENT_TC_API_URL=http://127.0.0.1:8001
AGENT_TC_BRIDGE_TOKEN=troque_este_token

# 0 = modo simulacao (confere tudo e nao grava). Mude para 1 depois de validar.
SVN_COMMIT=0

# Repositorios onde o Bridge pode gravar (separados por virgula).
SVN_ALLOWED_ROOTS=https://192.168.10.199:8443/svn/testcomplete

# Credenciais: o recomendado e NAO preencher. Logado na D01 com o usuario que roda a
# tarefa, rode uma vez:
#   svn info https://192.168.10.199:8443/svn/testcomplete --username <usuario do TC>
# e aceite salvar a senha (fica cifrada no perfil do Windows). Se preencher aqui, a senha
# fica em texto puro neste arquivo.
SVN_USERNAME=
SVN_PASSWORD=

# Se o certificado do servidor SVN nao for confiavel para o svn (ex.: unknown-ca).
SVN_TRUST_SERVER_CERT_FAILURES=

# Pasta do svn.exe/svnmucc.exe (padrao: TortoiseSVN).
# SVN_BIN_DIR=C:\Program Files\TortoiseSVN\bin

# Copie para PythonRodagem/.env em cada VM de rodagem.
# Nao commite o arquivo real: ele contem um token tecnico.

AGENT_TC_BACKEND=api
AGENT_TC_API_URL=http://192.168.9.201:8000
AGENT_TC_BRIDGE_TOKEN=mesmo_token_do_docker_env


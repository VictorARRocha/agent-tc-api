# =====================================================================
# Agent TC - exemplo de configuracao
# =====================================================================
# Nao commitar .env real. Senhas, tokens e chaves devem ficar somente no host.

# ---------------------------------------------------------------------
# Modo recomendado para VMs de rodagem:
# A VM envia o payload para a API central; a API grava no Postgres e salva
# evidencias no storage local configurado no Docker/host.
# ---------------------------------------------------------------------
AGENT_TC_BACKEND=api
AGENT_TC_API_URL=http://IP_DA_D01:8000
AGENT_TC_API_TOKEN=troque_este_token

# ---------------------------------------------------------------------
# Modo da API central fora do Docker, caso rode por script local.
# No Docker da D01, prefira API\deploy\d01\docker.env.
# ---------------------------------------------------------------------
# AGENT_TC_BACKEND=postgres
# POSTGRES_DSN=postgresql://agent_tc:senha@localhost:5432/agent_tc
POSTGRES_SCHEMA=public
POSTGRES_TABLE_PREFIX=agent_tc_

# Evidencias/arquivos quando a API central roda fora do Docker.
# No Docker da D01, isto ja e definido pelo docker-compose.
AGENT_TC_STORAGE=local
AGENT_TC_STORAGE_ROOT=S:\Teste automatico\Arquivos\AgenteTC\evidencias
AGENT_TC_PUBLIC_BASE_URL=http://IP_DA_D01:8000/files

# Token interno compartilhado entre API, AgenteTC das VMs e JenkinsBridge.
AGENT_TC_BRIDGE_TOKEN=troque_este_token

# Auth local da API. O primeiro cadastro vira admin aprovado para bootstrap.
AGENT_TC_AUTH_BACKEND=local
AGENT_TC_AUTH_SESSION_HOURS=24

# IA para agrupamento. Preencha somente o provedor escolhido.
AI_PROVIDER=openai
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=6000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=6000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_OUTPUT_TOKENS=12000

# ---------------------------------------------------------------------
# Legado/rollback:
# Supabase ainda existe como adapter no codigo, mas nao e o padrao de
# producao. Use apenas se precisar voltar temporariamente.
# ---------------------------------------------------------------------
# AGENT_TC_BACKEND=supabase
# AGENT_TC_STORAGE=supabase
# AGENT_TC_AUTH_BACKEND=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=evidencias-rodagens

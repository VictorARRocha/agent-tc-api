# Copie para MergeBridge\.env na D01 e NAO adicione o .env ao SVN.

# API Agent TC (a mesma usada pelo JenkinsBridge) e o mesmo AGENT_TC_BRIDGE_TOKEN
# de API\deploy\d01\docker.env.
AGENT_TC_API_URL=http://127.0.0.1:8001
AGENT_TC_BRIDGE_TOKEN=troque_este_token

# 0 = modo simulacao (faz a previa e o merge, desfaz e nao grava). Mude para 1 depois de validar.
MERGE_COMMIT=0

# Projeto do TC: a principal (MERGE_TRUNK_NAME) e as pastas de branches/ ficam aqui.
MERGE_PROJECT_URL=https://192.168.10.199:8443/svn/testcomplete/unico/ProjetoUnico
MERGE_TRUNK_NAME=Unico

# Copia de trabalho propria do Bridge (~2,5 GB; o primeiro checkout demora).
# Fora do Util Compartilhado e de qualquer outra copia do SVN.
MERGE_WC_DIR=C:\AgenteTC\merge_wc

# De quanto em quanto tempo (segundos) a lista de branches e atualizada no dashboard.
BRANCHES_REFRESH_SECONDS=120

# Credenciais: o recomendado e NAO preencher (mesmo esquema do RegravacaoBridge). Logado na
# D01 com o usuario que roda a tarefa, rode uma vez:
#   svn info https://192.168.10.199:8443/svn/testcomplete --username <usuario do TC>
# e aceite salvar a senha (fica cifrada no perfil do Windows).
SVN_USERNAME=
SVN_PASSWORD=

# Se o certificado do servidor SVN nao for confiavel para o svn (ex.: unknown-ca).
SVN_TRUST_SERVER_CERT_FAILURES=

# Pasta do svn.exe (padrao: TortoiseSVN).
# SVN_BIN_DIR=C:\Program Files\TortoiseSVN\bin

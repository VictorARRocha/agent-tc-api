# Copie para JenkinsBridge\.env na D01.
# Nao commitar o .env real; ele contem token do Jenkins.

JENKINS_URL=http://IP_DO_JENKINS:11000
JENKINS_JOB_PATH=/view/Progvisual20/job/testepipeline/buildWithParameters
JENKINS_USER=usuario_jenkins
JENKINS_API_TOKEN=token_jenkins

# Modo recomendado: Bridge fala com a API Agent TC.
JENKINS_BRIDGE_BACKEND=api
AGENT_TC_API_URL=http://127.0.0.1:8000

# Mesmo valor de AGENT_TC_BRIDGE_TOKEN do deploy\d01\docker.env.
AGENT_TC_BRIDGE_TOKEN=troque_este_token

# Legado/rollback:
# JENKINS_BRIDGE_BACKEND=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
